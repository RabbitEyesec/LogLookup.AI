# LogLookup AI v2 engine  systemd user service.
# Installed to ~/.config/systemd/user/loglookup.service by deploy/install.sh.
#
#   systemctl --user status loglookup     health at a glance
#   journalctl --user -u loglookup -f     live logs
#
# Type=notify + WatchdogSec: the engine signals READY when the API is up
# and heartbeats; systemd restarts it if the event loop ever wedges.

[Unit]
Description=LogLookup AI — SIEM alert triage & correlation engine
Documentation=https://localhost:8080/api/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/share/loglookup/venv/bin/loglookup serve
Environment=LOGLOOKUP_HOME=%h/.config/loglookup
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
WatchdogSec=120
# Graceful shutdown (v2): SIGTERM -> uvicorn drains requests -> source workers
# are cancelled and their HTTP clients closed -> the response dispatcher stops
# (an in-flight send is NOT retried; it resumes as reconciliation_required) ->
# the SQLite WAL is checkpointed. TimeoutStopSec bounds the whole sequence.
KillMode=mixed
SuccessExitStatus=143

# Hardening (user-service scope). The durable store lives under
# LOGLOOKUP_HOME (var/loglookup-v2.sqlite3), the only writable data path.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=%h/.config/loglookup %h/.local/share/loglookup

[Install]
WantedBy=default.target
